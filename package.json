{
  "name": "nest-react",
  "version": "1.0.0",
  "author": "Ike",
  "description": "A modern Tech Blog built with NestJS and React",
  "homepage": "https://github.com/LandazuriPaul/nest-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LandazuriPaul/nest-react.git"
  },
  "bugs": {
    "url": "https://github.com/LandazuriPaul/nest-react/issues"
  },
  "directories": {
    "doc": "docs"
  },
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "references": [
    {
      "path": "packages/domain"
    },
    {
      "path": "packages/lib"
    }
  ],
  "scripts": {
    "generate:version": "node scripts/generate_version.js",
    "start:domain": "pnpm --filter @nest-react/domain start:dev",
    "start:lib": "pnpm --filter @nest-react/lib start:dev",
    "start:common": "(pnpm start:domain & pnpm start:lib)",
    "build:domain": "pnpm --filter @nest-react/domain build",
    "build:lib": "pnpm --filter @nest-react/lib build",
    "build:common": "pnpm build:domain && pnpm build:lib",
    "build-push:server": "cross-env PACKAGE=server node scripts/build_and_push.js",
    "build-push:client": "cross-env PACKAGE=client node scripts/build_and_push.js",
    "lint": "pnpm -r run lint"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.2"
  }
}
